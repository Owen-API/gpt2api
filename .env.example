# ChatGPT2API production environment example.
# Copy to .env on each server and keep real secrets out of git.

CHATGPT2API_AUTH_KEY=your_secret_key_here
# CHATGPT2API_BASE_URL=https://api.example.com

# Production account-pool storage.
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://chatgpt2api:change_me@postgres-host:5432/chatgpt2api

# Local SQLite is supported only for development or migration sources:
# STORAGE_BACKEND=sqlite
# DATABASE_URL=sqlite:////app/data/accounts.db

# Git storage remains available for experiments, but production account pools
# should use PostgreSQL.
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git
# GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GIT_BRANCH=main
# GIT_FILE_PATH=accounts.json
